struct P { a: float32; b: int32; }
struct Q { p: int64*; }

@noinline fn pick(k: int64) -> int64 { return k; }
@noinline fn through(a: Q*, i: int64) -> int64 { var tmp: Q = a[i]; return *tmp.p; }

fn main() -> int32 {
  var x: int64 = 41;
  var ps: P[4];
  ps[1].b = 9;
  var p: P = ps[pick(1)];
  if (p.b != 9) { return 1; }
  var qs: Q[4];
  qs[2].p = &x;
  var q: Q = qs[pick(2)];
  if (*q.p != 41) { return 2; }
  if (through(&qs[0], pick(2)) != 41) { return 3; }
  return 0;
}
