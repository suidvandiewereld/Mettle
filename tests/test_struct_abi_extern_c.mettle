// Struct ABI C boundary: Mettle calls C functions that pass/return
// Microsoft x64 indirect structs by value.
import "std/conv";
import "std/io";

struct ThreeI32 {
  a: int32;
  b: int32;
  c: int32;
}

struct Odd3 {
  a: uint8;
  b: uint8;
  c: uint8;
}

extern fn c_sum_three(t: ThreeI32) -> int32 = "mettle_struct_abi_c_sum_three";
extern fn c_make_three(a: int32, b: int32, c: int32) -> ThreeI32 = "mettle_struct_abi_c_make_three";
extern fn c_sum_odd3(o: Odd3) -> int32 = "mettle_struct_abi_c_sum_odd3";
extern fn c_make_odd3(a: uint8, b: uint8, c: uint8) -> Odd3 = "mettle_struct_abi_c_make_odd3";

// SysV classifies each eightbyte, so these three shapes each travel a
// different way: Big32 is MEMORY (stack by value), TwoF64 is two SSE
// eightbytes (two XMM registers), and MixedI64F64 is one integer eightbyte
// and one SSE. Microsoft x64 passes all three by pointer, so the same source
// exercises both rules.
struct Big32 {
  a: int32; b: int32; c: int32; d: int32;
  e: int32; f: int32; g: int32; h: int32;
}

struct TwoF64 {
  x: float64;
  y: float64;
}

struct MixedI64F64 {
  i: int64;
  d: float64;
}

extern fn c_sum_big32(v: Big32) -> int32 = "mettle_struct_abi_c_sum_big32";
extern fn c_sum_two_f64(v: TwoF64) -> int32 = "mettle_struct_abi_c_sum_two_f64";
extern fn c_sum_mixed(v: MixedI64F64) -> int32 = "mettle_struct_abi_c_sum_mixed";

struct Rgba {
  r: uint8; g: uint8; b: uint8; a: uint8;
}

struct PairI32 {
  a: int32;
  b: int32;
}

struct TwoF32 {
  x: float32;
  y: float32;
}

extern fn c_sum_rgba(c: Rgba) -> int32 = "mettle_struct_abi_c_sum_rgba";
extern fn c_make_rgba(r: uint8, g: uint8, b: uint8, a: uint8) -> Rgba = "mettle_struct_abi_c_make_rgba";
extern fn c_sum_pair(p: PairI32) -> int32 = "mettle_struct_abi_c_sum_pair";
extern fn c_sum_two_f32(v: TwoF32) -> int32 = "mettle_struct_abi_c_sum_two_f32";
extern fn c_sum_spilled(a: int32, b: int32, c: int32, d: int32, e: int32, f: int32, p: PairI32, v: TwoF32, k: Rgba) -> int32 = "mettle_struct_abi_c_sum_spilled";

fn write_s(s: cstring) {
  if (s != 0) {
    fputs(s, get_stdout());
  }
}

fn write_i64(v: int64) {
  var buf: uint8[32];
  int_to_dec((cstring)((int64)(&(buf[0]))), v);
  write_s((cstring)((int64)(&(buf[0]))));
}

fn line_i64(label: cstring, v: int64) {
  write_s(label);
  write_s(" ");
  write_i64(v);
  write_s("\n");
}

fn make_three(a: int32, b: int32, c: int32) -> ThreeI32 {
  var t: ThreeI32;
  t.a = a;
  t.b = b;
  t.c = c;
  return t;
}

fn make_rgba(r: int32, g: int32, b: int32, a: int32) -> Rgba {
  var c: Rgba;
  c.r = (uint8)r;
  c.g = (uint8)g;
  c.b = (uint8)b;
  c.a = (uint8)a;
  return c;
}

fn make_pair(a: int32, b: int32) -> PairI32 {
  var p: PairI32;
  p.a = a;
  p.b = b;
  return p;
}

fn make_two_f32(x: float32, y: float32) -> TwoF32 {
  var v: TwoF32;
  v.x = x;
  v.y = y;
  return v;
}

fn main() -> int32 {
  write_s("struct abi extern c\n");

  var t: ThreeI32 = make_three(11, 22, 33);
  line_i64("c_sum_three", (int64)c_sum_three(t));

  var u: ThreeI32 = c_make_three(3, 4, 5);
  line_i64("c_make_three_sum", (int64)(u.a + u.b + u.c));

  var o: Odd3 = c_make_odd3(7, 8, 9);
  line_i64("c_make_odd3_sum", (int64)c_sum_odd3(o));

  var big: Big32;
  big.a = 1; big.b = 2; big.c = 3; big.d = 4;
  big.e = 5; big.f = 6; big.g = 7; big.h = 8;
  line_i64("c_sum_big32", (int64)c_sum_big32(big));

  var pair: TwoF64;
  pair.x = 10.5;
  pair.y = 21.5;
  line_i64("c_sum_two_f64", (int64)c_sum_two_f64(pair));

  var mixed: MixedI64F64;
  mixed.i = 100;
  mixed.d = 7.0;
  line_i64("c_sum_mixed", (int64)c_sum_mixed(mixed));

  var rgba: Rgba = make_rgba(1, 2, 3, 4);
  line_i64("c_sum_rgba_local", (int64)c_sum_rgba(rgba));
  line_i64("c_sum_rgba_call", (int64)c_sum_rgba(make_rgba(5, 6, 7, 8)));
  line_i64("c_sum_rgba_extern", (int64)c_sum_rgba(c_make_rgba(9, 8, 7, 6)));
  var pr: PairI32 = make_pair(3, 4);
  line_i64("c_sum_pair_local", (int64)c_sum_pair(pr));
  line_i64("c_sum_pair_call", (int64)c_sum_pair(make_pair(5, 6)));
  line_i64("c_sum_two_f32_call", (int64)c_sum_two_f32(make_two_f32(1.5, 2.25)));
  line_i64("c_sum_spilled", (int64)c_sum_spilled(1, 2, 3, 4, 5, 6, make_pair(1, 1), make_two_f32(1.0, 1.0), make_rgba(0, 0, 0, 1)));
  line_i64("locals_intact", (int64)((int32)rgba.r + (int32)rgba.a + pr.b));

  return 0;
}
