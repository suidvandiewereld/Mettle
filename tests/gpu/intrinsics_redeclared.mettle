extern fn sqrtf(x: float32) -> float32 = "sqrtf";
extern fn expf(x: float32) -> float32 = "expf";
extern fn rsqrtf(x: float32) -> float32 = "rsqrtf";
extern fn h2f(bits: int32) -> float32 = "h2f";
extern fn f2h(x: float32) -> int32 = "f2h";
extern fn prmt_b32(a: uint32, b: uint32, sel: uint32) -> uint32 = "prmt_b32";
extern fn dp4a_s32(a: int32, b: int32, c: int32) -> int32 = "dp4a_s32";
extern fn hadd2(a: uint32, b: uint32) -> uint32 = "hadd2";
extern fn f2h2(lo: float32, hi: float32) -> uint32 = "f2h2";
extern fn h2f_lo(p: uint32) -> float32 = "h2f_lo";
extern fn load4_u32(src: uint32*, dst: uint32*) = "load4_u32";
extern fn mbarrier_init(bar: uint64 shared*, count: uint32) = "mbarrier_init";
extern fn fence_mbarrier_init() = "fence_mbarrier_init";
extern fn gpu_barrier() = "gpu_barrier";
extern fn f32_from_bits(bits: uint32) -> float32 = "f32_from_bits";
extern fn bits_from_f32(x: float32) -> uint32 = "bits_from_f32";
extern fn bf2f(bits: uint32) -> float32 = "bf2f";
extern fn f2bf(x: float32) -> uint32 = "f2bf";

kernel(block = 32) builtin_intrinsics(out: float32*, h: uint16*, w: uint32*) {
  workgroup var s8: uint8 align(16)*;
  var bar: uint64 shared* = (uint64 shared*)s8;
  var x: float32 = out[thread.x];
  var a: float32 = sqrtf(x) + expf(x) + rsqrtf(x + 1.0) + h2f((int32)h[thread.x]);
  var p: uint32 = prmt_b32(w[0], w[1], 0x5410);
  var d: int32 = dp4a_s32((int32)p, 3, 7);
  var half2: uint32 = hadd2(f2h2(a, x), w[2]);
  var four: uint32[4];
  load4_u32(w, &four[0]);
  if (thread.x == 0) {
    mbarrier_init(bar, 1);
    fence_mbarrier_init();
  }
  gpu_barrier();
  out[thread.x] = a + (float32)d + (float32)four[2] + (float32)f2h(a) + h2f_lo(half2) +
                  f32_from_bits(bits_from_f32(x)) + bf2f(f2bf(x));
}
