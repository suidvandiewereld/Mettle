@noinline fn unrolled_counter_survives() -> int32 {
  var m6: int16 = (int16)1;
  var i13: int64 = 3;
  while (i13 < 4) {
    if (m6 < m6) { break; }
    i13 = i13 + 1;
  }
  if (i13 != (int64)4) { return 1; }
  return 0;
}

@noinline fn dropped_cast_keeps_signed_compare() -> int32 {
  var m30: int32 = (int32)(-5);
  var v40: uint64 = (uint64)1;
  if (m30 < ((int32)(v40))) {
    v40 = (uint64)0;
  }
  if (v40 != (uint64)0) { return 2; }
  return 0;
}

@noinline fn composed_widening_keeps_signed_compare() -> int32 {
  var m7: uint32 = (uint32)1;
  if ((int64)(-5423329592128216073) < ((int64)((uint32)1))) {
    m7 = (uint32)0;
  }
  if (m7 != (uint32)0) { return 3; }
  return 0;
}

@noinline fn unsigned_cast_of_signed_byte_load(p: int8*, i: int64) -> int64 {
  return (int64)((uint8)p[i]);
}

@noinline fn unsigned_cast_of_signed_short_load(p: int16*, i: int64) -> int64 {
  return (int64)((uint16)p[i]);
}

@noinline fn unroll_limit_written_in_body() -> int64 {
  var n: int64 = 5;
  var i: int64 = 0;
  var s: int64 = 0;
  while (i < n) {
    n = n - 1;
    s = s + 10;
    i = i + 1;
  }
  return s + i * 1000 + n * 100000;
}

var g_unroll_limit: int64 = 10;

@noinline fn shrink_unroll_limit() -> void {
  g_unroll_limit = g_unroll_limit - 3;
}

@noinline fn annotated_unroll_global_limit() -> int64 {
  var i: int64 = 0;
  var c: int64 = 0;
  @unroll(4) while (i < g_unroll_limit) {
    shrink_unroll_limit();
    c = c + 1;
    i = i + 1;
  }
  return c;
}

fn main() -> int32 {
  var r: int32 = unrolled_counter_survives();
  if (r != 0) { return r; }
  r = dropped_cast_keeps_signed_compare();
  if (r != 0) { return r; }
  r = composed_widening_keeps_signed_compare();
  if (r != 0) { return r; }
  var bytes: int8[4];
  bytes[2] = (int8)(-3);
  if (unsigned_cast_of_signed_byte_load(&bytes[0], (int64)2) != 253) { return 4; }
  var shorts: int16[4];
  shorts[1] = (int16)(-2);
  if (unsigned_cast_of_signed_short_load(&shorts[0], (int64)1) != 65534) { return 5; }
  if (unroll_limit_written_in_body() != 203030) { return 6; }
  if (annotated_unroll_global_limit() != 3) { return 7; }
  return 0;
}
