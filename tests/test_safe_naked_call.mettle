@naked fn forty_two() -> int64 {
    asm {
        mov eax, 42
        ret
    }
}

@noinline fn pick(k: int64) -> int64 { return k; }

fn main() -> int32 {
  var total: int64 = 0;
  var i: int64 = 0;
  while (i < pick(3)) {
    total = total + forty_two();
    i = i + 1;
  }
  if (total != 126) { return 1; }
  return 0;
}
