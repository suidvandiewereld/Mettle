import "std/io";

@noinline fn opaque64(v: int64) -> int64 {
  return v;
}

fn sel_i32_lt(a: int32, b: int32) -> int32 {
  var r: int32 = a;
  if (a < b) {
    r = b;
  }
  return r;
}

@noinline fn ref_i32_lt(a: int32, b: int32) -> int32 {
  var r: int32 = a;
  if (a < b) {
    r = (int32)opaque64((int64)b);
  }
  return r;
}

fn sel_i32_le(a: int32, b: int32) -> int32 {
  var r: int32 = a;
  if (a <= b) {
    r = b;
  }
  return r;
}

@noinline fn ref_i32_le(a: int32, b: int32) -> int32 {
  var r: int32 = a;
  if (a <= b) {
    r = (int32)opaque64((int64)b);
  }
  return r;
}

fn sel_i32_gt(a: int32, b: int32) -> int32 {
  var r: int32 = a;
  if (a > b) {
    r = b;
  }
  return r;
}

@noinline fn ref_i32_gt(a: int32, b: int32) -> int32 {
  var r: int32 = a;
  if (a > b) {
    r = (int32)opaque64((int64)b);
  }
  return r;
}

fn sel_i32_ge(a: int32, b: int32) -> int32 {
  var r: int32 = a;
  if (a >= b) {
    r = b;
  }
  return r;
}

@noinline fn ref_i32_ge(a: int32, b: int32) -> int32 {
  var r: int32 = a;
  if (a >= b) {
    r = (int32)opaque64((int64)b);
  }
  return r;
}

fn sel_i32_eq(a: int32, b: int32) -> int32 {
  var r: int32 = a;
  if (a == b) {
    r = b;
  }
  return r;
}

@noinline fn ref_i32_eq(a: int32, b: int32) -> int32 {
  var r: int32 = a;
  if (a == b) {
    r = (int32)opaque64((int64)b);
