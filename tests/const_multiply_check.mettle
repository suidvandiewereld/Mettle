fn main() -> int32 {
  var bad: int32 = 0;
  var sel: int32 = 0;
  while (sel < 60) {
    var seed: int64 = -9;
    while (seed < 40) {
      var x: int64 = seed * 2654435761 + 7;
      var got: int64 = mul_const64(x, sel);
      var want: int64 = mul_dyn64(x, const_of64(sel));
      if (got != want) {
        println("mul64 sel={sel} x={x} got={got} want={want}");
        bad = bad + 1;
      }
      var x32: int32 = (int32)(seed * 65599 + 13);
      var got32: int32 = mul_const32(x32, sel);
      var want32: int32 = mul_dyn32(x32, const_of32(sel));
      if (got32 != want32) {
        println("mul32 sel={sel} x={x32} got={got32} want={want32}");
        bad = bad + 1;
      }
      seed = seed + 1;
    }
    sel = sel + 1;
  }
  if (bad != 0) {
    return 1;
  }
  println("CONST MULTIPLY: ALL OK");
  return 0;
}
