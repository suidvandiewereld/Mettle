import "std/io";
import "std/mem";
import "std/gpu";
import "std/math";
import "decode_decls";

const DIM: int32 = 1024;
const HIDDEN: int32 = 2816;
const STEPS: int32 = 200;

fn unit() -> float64 {
  return 0.000000059604644775390625;
}

fn magnitude(v: float64) -> float64 {
  if (v < 0.0) { return -v; }
  return v;
}

fn bound_use(got: float32, exact: float64, bound: float64) -> float64 {
  var limit: float64 = bound;
  if (limit < 1.0e-30) { limit = 1.0e-30; }
  return magnitude((float64)got - exact) / limit;
}

fn larger(a: float64, b: float64) -> float64 {
  if (b > a) { return b; }
  return a;
}

fn check_rmsnorm(x: float32*, weight: float32*, got: float32*, dim: int32) -> float64 {
  var squares: float64 = 0.0;
  for i in 0..dim {
    squares = squares + (float64)x[i] * (float64)x[i];
  }
  var epsilon: float64 = (float64)((float32)0.00001);
  var scale: float64 = 1.0 / sqrt(squares / (float64)dim + epsilon);
  var worst: float64 = 0.0;
  for i in 0..dim {
    var exact: float64 = (float64)x[i] * scale * (float64)weight[i];
    var bound: float64 = magnitude(exact) * (float64)(dim + 16) * unit();
    worst = larger(worst, bound_use(got[i], exact, bound));
  }
  return worst;
}

fn check_matvec(w: float32*, x: float32*, got: float32*, rows: int32, cols: int32) -> float64 {
  var gamma: float64 = (float64)(cols + 2) * unit();
  gamma = gamma / (1.0 - gamma);
  var worst: float64 = 0.0;
  for r in 0..rows {
    var exact: float64 = 0.0;
    var size: float64 = 0.0;
    var base: int32 = r * cols;
    for c in 0..cols {
      var term: float64 = (float64)w[base + c] * (float64)x[c];
      exact = exact + term;
      size = size + magnitude(term);
    }
    worst = larger(worst, bound_use(got[r], exact, gamma * size));
  }
  return worst;
}

fn check_silu_mul(gate: float32*, up: float32*, got: float32*, n: int32) -> float64 {
  var worst: float64 = 0.0;
  for i in 0..n {
    var g: float64 = (float64)gate[i];
    var exact: float64 = g / (1.0 + exp(-g)) * (float64)up[i];
    var bound: float64 = magnitude(exact) * 32.0 * unit();
    worst = larger(worst, bound_use(got[i], exact, bound));
  }
  return worst;
}

fn check_softmax(logits: float32*, got: float32*, n: int32) -> float64 {
  var largest: float64 = (float64)logits[0];
  for i in 0..n {
    if ((float64)logits[i] > largest) { largest = (float64)logits[i]; }
  }
  var total: float64 = 0.0;
  for i in 0..n {
    total = total + exp((float64)logits[i] - largest);
  }
  var worst: float64 = 0.0;
  for i in 0..n {
    var gap: float64 = largest - (float64)logits[i];
    var exact: float64 = exp(-gap) / total;
    var bound: float64 = magnitude(exact) * (gap + (float64)n + 16.0) * unit();
    worst = larger(worst, bound_use(got[i], exact, bound));
  }
  return worst;
}

fn fill(buffer: float32*, n: int32, seed: int32) {
  var state: int32 = seed;
  for i in 0..n {
    state = state * 1103515245 + 12345;
    var bits: int32 = (state >> 16) & 1023;
    buffer[i] = ((float32)bits / (float32)512.0) - (float32)1.0;
  }
}

fn main() -> int32 {
  if (gpu_open_kernels("decode_kernels") == 0) { return 1; }

  var name: uint8[128];
  println("device   {gpu_device_name(0, &name[0], 128)}");
  if (gpu_sm_count(0) > 0) {
    println("         {gpu_sm_count(0)} SMs, compute {gpu_compute_capability(0)}, CUDA {gpu_driver_version() / 1000}.{(gpu_driver_version() % 1000) / 10}");
  } else {
    print_cstr("         ");
    print_cstr(gpu_provider_name());
    println("");
  }
  println("layer    dim {DIM} -> hidden {HIDDEN}, {STEPS} steps");
  println("");

  var vector_bytes: int64 = (int64)DIM * 4;
  var hidden_bytes: int64 = (int64)HIDDEN * 4;
  var projection_bytes: int64 = (int64)HIDDEN * (int64)DIM * 4;

  var h_x: float32* = malloc(vector_bytes);
  var h_norm_weight: float32* = malloc(vector_bytes);
  var h_gate_w: float32* = malloc(projection_bytes);
  var h_up_w: float32* = malloc(projection_bytes);
  var h_down_w: float32* = malloc(projection_bytes);
  fill(h_x, DIM, 1);
  fill(h_norm_weight, DIM, 2);
  fill(h_gate_w, HIDDEN * DIM, 3);
  fill(h_up_w, HIDDEN * DIM, 4);
  fill(h_down_w, HIDDEN * DIM, 5);

  var d_x: int64 = gpu_malloc(vector_bytes);
  var d_norm_weight: int64 = gpu_malloc(vector_bytes);
  var d_normed: int64 = gpu_malloc(vector_bytes);
  var d_gate_w: int64 = gpu_malloc(projection_bytes);
  var d_up_w: int64 = gpu_malloc(projection_bytes);
  var d_down_w: int64 = gpu_malloc(projection_bytes);
  var d_gate: int64 = gpu_malloc(hidden_bytes);
  var d_up: int64 = gpu_malloc(hidden_bytes);
  var d_activated: int64 = gpu_malloc(hidden_bytes);
  var d_down: int64 = gpu_malloc(vector_bytes);
  var d_out: int64 = gpu_malloc(vector_bytes);
  if (d_out == 0) { println("out of device memory"); return 1; }

  gpu_to_device(d_x, (uint8*)h_x, vector_bytes);
  gpu_to_device(d_norm_weight, (uint8*)h_norm_weight, vector_bytes);
  gpu_to_device(d_gate_w, (uint8*)h_gate_w, projection_bytes);
  gpu_to_device(d_up_w, (uint8*)h_up_w, projection_bytes);
  gpu_to_device(d_down_w, (uint8*)h_down_w, projection_bytes);

  var stream: int64 = gpu_stream_create();

  dispatch rmsnorm[1, 256](d_x, d_norm_weight, d_normed, DIM) on stream;
  dispatch matvec[work: HIDDEN](d_gate_w, d_normed, d_gate, HIDDEN, DIM) on stream;
  dispatch matvec[work: HIDDEN](d_up_w, d_normed, d_up, HIDDEN, DIM) on stream;
  dispatch silu_mul[work: HIDDEN](d_gate, d_up, d_activated, HIDDEN) on stream;
  dispatch matvec[work: DIM](d_down_w, d_activated, d_down, DIM, HIDDEN) on stream;
  dispatch softmax[1, 256](d_down, d_out, DIM) on stream;
  gpu_stream_sync(stream);

  var g_normed: float32* = malloc(vector_bytes);
  var g_gate: float32* = malloc(hidden_bytes);
  var g_up: float32* = malloc(hidden_bytes);
  var g_activated: float32* = malloc(hidden_bytes);
  var g_down: float32* = malloc(vector_bytes);
  var g_out: float32* = malloc(vector_bytes);
  gpu_to_host((uint8*)g_normed, d_normed, vector_bytes);
  gpu_to_host((uint8*)g_gate, d_gate, hidden_bytes);
  gpu_to_host((uint8*)g_up, d_up, hidden_bytes);
  gpu_to_host((uint8*)g_activated, d_activated, hidden_bytes);
  gpu_to_host((uint8*)g_down, d_down, vector_bytes);
  gpu_to_host((uint8*)g_out, d_out, vector_bytes);

  var worst: float64 = check_rmsnorm(h_x, h_norm_weight, g_normed, DIM);
  worst = larger(worst, check_matvec(h_gate_w, g_normed, g_gate, HIDDEN, DIM));
  worst = larger(worst, check_matvec(h_up_w, g_normed, g_up, HIDDEN, DIM));
  worst = larger(worst, check_silu_mul(g_gate, g_up, g_activated, HIDDEN));
  worst = larger(worst, check_matvec(h_down_w, g_activated, g_down, DIM, HIDDEN));
  worst = larger(worst, check_softmax(g_down, g_out, DIM));
  if (worst > 1.0) {
    println("MISMATCH: a stage is {worst} times its float32 error bound");
    return 1;
  }
  println("correct  every stage within its float32 error bound, worst at {worst * 100.0}% of it");

  var start: int64 = gpu_event_create();
  var finish: int64 = gpu_event_create();

  gpu_event_record(start, stream);
  for step in 0..STEPS {
    dispatch rmsnorm[1, 256](d_x, d_norm_weight, d_normed, DIM) on stream;
    dispatch matvec[work: HIDDEN](d_gate_w, d_normed, d_gate, HIDDEN, DIM) on stream;
    dispatch matvec[work: HIDDEN](d_up_w, d_normed, d_up, HIDDEN, DIM) on stream;
    dispatch silu_mul[work: HIDDEN](d_gate, d_up, d_activated, HIDDEN) on stream;
    dispatch matvec[work: DIM](d_down_w, d_activated, d_down, DIM, HIDDEN) on stream;
    dispatch softmax[1, 256](d_down, d_out, DIM) on stream;
  }
  gpu_event_record(finish, stream);
  gpu_event_sync(finish);
  var launched_ms: float32 = (float32)0.0;
  gpu_event_elapsed_ms(start, finish, &launched_ms);

  if (gpu_graph_capture_begin(stream) != 0) {
    println("stream capture unavailable");
    return 1;
  }
  dispatch rmsnorm[1, 256](d_x, d_norm_weight, d_normed, DIM) on stream;
  dispatch matvec[work: HIDDEN](d_gate_w, d_normed, d_gate, HIDDEN, DIM) on stream;
  dispatch matvec[work: HIDDEN](d_up_w, d_normed, d_up, HIDDEN, DIM) on stream;
  dispatch silu_mul[work: HIDDEN](d_gate, d_up, d_activated, HIDDEN) on stream;
  dispatch matvec[work: DIM](d_down_w, d_activated, d_down, DIM, HIDDEN) on stream;
  dispatch softmax[1, 256](d_down, d_out, DIM) on stream;
  var graph: int64 = gpu_graph_capture_end(stream);
  if (graph == 0) { println("graph instantiation failed"); return 1; }

  gpu_event_record(start, stream);
  for step in 0..STEPS {
    gpu_graph_launch(graph, stream);
  }
  gpu_event_record(finish, stream);
  gpu_event_sync(finish);
  var replayed_ms: float32 = (float32)0.0;
  gpu_event_elapsed_ms(start, finish, &replayed_ms);

  println("");
  println("per step launched   {launched_ms / (float32)STEPS} ms");
  println("per step replayed   {replayed_ms / (float32)STEPS} ms  (one captured graph)");

  gpu_graph_destroy(graph);
  gpu_event_destroy(start);
  gpu_event_destroy(finish);
  gpu_stream_destroy(stream);
  gpu_free(d_x); gpu_free(d_norm_weight); gpu_free(d_normed);
  gpu_free(d_gate_w); gpu_free(d_up_w); gpu_free(d_down_w);
  gpu_free(d_gate); gpu_free(d_up); gpu_free(d_activated);
  gpu_free(d_down); gpu_free(d_out);
  return 0;
}
